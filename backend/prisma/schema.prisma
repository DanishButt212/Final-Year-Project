// DigitalAdaalat database schema.
// Money is always Decimal(12,2) PKR, never Float.
// AuditLog is append-only: a PostgreSQL trigger (see migrations) blocks UPDATE and DELETE.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  LITIGANT
  LAWYER
  INTERN
  PROCESS_SERVER
  JUDGE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED // access revoked by an administrator
  DEACTIVATED // soft-deleted
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CourtType {
  DISTRICT_SESSIONS
  HIGH_COURT
}

enum CaseType {
  CIVIL_SUIT
  CRIMINAL_APPEAL
  WRIT_PETITION
  BAIL_APPLICATION
}

enum CaseStatus {
  DRAFT
  PENDING_ASSIGNMENT
  FILED
  UNDER_SCRUTINY
  ALLOCATED
  PENDING
  HEARING_FIXED
  DECIDED
  REJECTED
  DISMISSED
}

enum CaseEventType {
  CASE_SUBMITTED
  DOCUMENT_ATTACHED
  CASE_ALLOCATED
  HEARING_SCHEDULED
  HEARING_RESCHEDULED
  HEARING_CANCELLED
  PAYMENT_RECEIVED
  EVIDENCE_ADDED
  EVIDENCE_LOCKED
  SUMMONS_ISSUED
  SUMMONS_ATTEMPT
  SUMMONS_EXECUTED
  SUMMONS_REASSIGNED
  SUMMONS_CANCELLED
  HEARING_COMPLETED
  HEARING_ADJOURNED
  CASE_DECIDED
  SESSION_INITIALIZED
  SESSION_ENDED
}

enum EvidenceCategory {
  VIDEO
  AUDIO
  SCANNED_DOCUMENT
}

enum FeedbackCategory {
  USABILITY
  TECHNICAL_ISSUE
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  PROCESSED
  ARCHIVED
}

enum PartyRole {
  PETITIONER
  RESPONDENT
  APPELLANT
  ACCUSED
  COMPLAINANT
  WITNESS
}

enum DocumentType {
  PLEADING
  ORDER
  JUDGMENT
  ANNEXURE
  OTHER
}

enum HearingType {
  PHYSICAL
  VIRTUAL
}

enum HearingStatus {
  SCHEDULED
  HELD
  ADJOURNED
  CANCELLED
}

enum DecisionType {
  JUDGMENT
  DISMISSED
  DISPOSED
}

enum SecurityAlertStatus {
  OPEN
  DISMISSED
  BLOCKED
}

enum ReportKind {
  PERFORMANCE
  AUDIT_TRAIL
}

enum ReportFormat {
  PDF
  EXCEL
}

enum CauseListStatus {
  DRAFT
  PUBLISHED
}

enum ChallanStatus {
  UNPAID
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  MOCK_CARD
  MOCK_WALLET
  MOCK_BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SummonsStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ATTEMPT_IN_PROGRESS
  EXECUTED
  CANCELLED
}

enum NoticeType {
  SUMMONS
  NOTICE
}

enum SummonsPriority {
  URGENT
  NORMAL
}

enum ServiceMode {
  PERSONAL_DELIVERY
  REFUSED_AFFIXED
}

enum ServerStatus {
  ACTIVE
  SUSPENDED
}

enum RetainerTxType {
  DEPOSIT
  DEDUCTION
  REFUND
}

enum DiaryReviewStatus {
  SUBMITTED
  APPROVED
  NEEDS_REVISION
}

enum ChamberLicenseStatus {
  ACTIVE
  SUSPENDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum SessionStatus {
  LOBBY_LOCKED
  ACTIVE
  ENDED
}

enum ParticipantRole {
  JUDGE
  LAWYER
  LITIGANT
  OBSERVER
  ADMIN
}

enum ParticipantStatus {
  JOINED
  MUTED
  VIDEO_OFF
  EJECTED
}

enum SessionCommand {
  MUTE_AUDIO
  DISABLE_VIDEO
  EJECT
  READMIT
}

// ---------------------------------------------------------------- identity

/// FR: registration, login, user management (UC: Register, Login, Manage Users)
model User {
  id                    String     @id @default(uuid())
  role                  Role
  firstName             String
  lastName              String
  cnic                  String     @unique
  email                 String     @unique
  username              String?    @unique // used by admin accounts to log in
  phone                 String
  passwordHash          String
  status                UserStatus @default(ACTIVE)
  profileImage          String?
  courtId               String? // judges are attached to a court
  courtroomId           String? // and optionally to a courtroom
  lastLoginAt           DateTime?
  sessionsInvalidatedAt DateTime? // tokens issued before this moment are rejected
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  court                  Court?                    @relation(fields: [courtId], references: [id])
  courtroom              Courtroom?                @relation(fields: [courtroomId], references: [id])
  lawyerProfile          LawyerProfile?
  internProfile          InternProfile?
  passwordResetTokens    PasswordResetToken[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  feedbacks              Feedback[]
  filedCases             Case[]                    @relation("CaseFiledBy")
  judgeCases             Case[]                    @relation("CaseJudge")
  judgeHearings          Hearing[]                 @relation("HearingJudge")
  uploadedDocuments      CaseDocument[]
  uploadedEvidence       Evidence[]                @relation("EvidenceUploader")
  lockedEvidence         Evidence[]                @relation("EvidenceLocker")
  reviewedFeedback       Feedback[]                @relation("FeedbackReviewer")
  challansPaid           Challan[]
  payments               Payment[]
  summonsServed          Summons[]                 @relation("SummonsServer")
  summonsIssued          Summons[]                 @relation("SummonsIssuer")
  summonsAttempts        SummonsAttempt[]          @relation("AttemptServer")
  serverProfile          ProcessServerProfile?
  reviewedDiaryEntries   InternDiaryEntry[]        @relation("DiaryReviewer")
  verifiedLawyers        LawyerProfile[]           @relation("LawyerVerifier")
  sessionParticipation   CourtSessionParticipant[]
  initializedSessions    CourtSession[]
  createdCauseLists      CauseList[]
  caseEvents             CaseEvent[]
  blockedHosts           BlockedHost[]
  generatedReports       GeneratedReport[]

  @@index([role, status])
  @@index([courtId])
}

/// FR: lawyer verification via Bar Council (UC: Verify Lawyer)
model LawyerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  barNumber          String?            @unique
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  verifiedBy  User?             @relation("LawyerVerifier", fields: [verifiedById], references: [id])
  interns     InternProfile[]
  caseParties CaseParty[]
  clients     ChamberClient[]
  billable    BillableEntry[]
  expenses    ChamberExpense[]
  chamber     ChamberProfile?
  alertLogs   ChamberAlertLog[]

  @@index([verificationStatus])
}

/// FR: legal intern tracking (UC: Manage Intern, Review Diary)
model InternProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  supervisorId        String
  startDate           DateTime  @db.Date
  endDate             DateTime? @db.Date
  certificateIssuedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  supervisor     LawyerProfile          @relation(fields: [supervisorId], references: [id])
  diary          InternDiaryEntry[]
  attendance     Attendance[]
  serverProfiles ProcessServerProfile[]

  @@index([supervisorId])
}

/// FR: forgot/reset password (UC: Reset Password); only the SHA-256 hash is stored
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- courts

/// FR: court and bench management (UC: Manage Courts)
model Court {
  id              String    @id @default(uuid())
  name            String    @unique
  type            CourtType
  city            String
  isActive        Boolean   @default(true)
  /// Court complex geo-fence for intern attendance (null = attendance cannot be verified here)
  latitude        Decimal?  @db.Decimal(9, 6)
  longitude       Decimal?  @db.Decimal(9, 6)
  geofenceRadiusM Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  courtrooms            Courtroom[]
  judges                User[]
  cases                 Case[]
  causeLists            CauseList[]
  attendance            Attendance[]
  processServerProfiles ProcessServerProfile[]

  @@index([city])
}

/// FR: courtroom/bench allocation and scheduling (UC: Build Cause List)
model Courtroom {
  id        String   @id @default(uuid())
  courtId   String
  name      String
  benchNo   Int?
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court    Court     @relation(fields: [courtId], references: [id])
  cases    Case[]
  hearings Hearing[]
  judges   User[]

  @@unique([courtId, name])
}

// ---------------------------------------------------------------- cases

/// FR 3-1, FR 3-3: electronic filing and Unique Case Number (UC-2.1 Submit New Case, UC-2.3 View Case Portfolio)
model Case {
  id             String        @id @default(uuid())
  ucn            String        @unique
  caseType       CaseType
  status         CaseStatus    @default(DRAFT)
  title          String
  reliefSought   String
  claimAmountPkr Decimal?      @db.Decimal(14, 2) // optional claim value, used for the Civil Suit ad valorem fee
  filingDate     DateTime?     @db.Date
  filedById      String
  courtId        String?
  courtroomId    String?
  judgeId        String?
  allocatedAt    DateTime?
  decidedAt      DateTime?
  decisionType   DecisionType?
  decisionText   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  filedBy      User               @relation("CaseFiledBy", fields: [filedById], references: [id])
  judge        User?              @relation("CaseJudge", fields: [judgeId], references: [id])
  court        Court?             @relation(fields: [courtId], references: [id])
  courtroom    Courtroom?         @relation(fields: [courtroomId], references: [id])
  parties      CaseParty[]
  documents    CaseDocument[]
  evidence     Evidence[]
  hearings     Hearing[]
  challans     Challan[]
  summons      Summons[]
  billable     BillableEntry[]
  diaryEntries InternDiaryEntry[]
  events       CaseEvent[]

  @@index([filedById])
  @@index([judgeId, status])
  @@index([courtId, status])
  @@index([caseType, status])
  @@index([filingDate])
}

/// FR: parties and their counsel on a case (UC: File Case); lawyerId drives lawyer anti-clash checks
model CaseParty {
  id        String    @id @default(uuid())
  caseId    String
  role      PartyRole
  name      String
  cnic      String?
  phone     String?
  address   String?
  lawyerId  String?
  position  Int       @default(0) // order within its side (petitioners / respondents)
  createdAt DateTime  @default(now())

  case    Case           @relation(fields: [caseId], references: [id])
  lawyer  LawyerProfile? @relation(fields: [lawyerId], references: [id])
  summons Summons[]

  @@index([caseId])
  @@index([lawyerId, caseId]) // supports lawyer double-booking lookups
}

/// FR 3-2: PDF pleading upload, max 25 MB, locked once attached (UC-2.2 Upload Legal Pleadings)
model CaseDocument {
  id           String       @id @default(uuid())
  caseId       String
  type         DocumentType @default(PLEADING)
  title        String
  originalName String // file name as uploaded by the user (never used as a path)
  filePath     String // storage key, e.g. cases/<caseId>/<uuid>.pdf
  sha256       String
  mimeType     String       @default("application/pdf")
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime     @default(now())

  case       Case @relation(fields: [caseId], references: [id])
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([caseId, type])
}

/// FR: evidence vault (UC: Manage Evidence)
model Evidence {
  id           String           @id @default(uuid())
  caseId       String
  category     EvidenceCategory
  title        String
  originalName String
  description  String?
  filePath     String // storage key of the ENCRYPTED file (AES-256-GCM)
  mimeType     String
  sizeBytes    Int // size of the original file
  sha256       String // SHA-256 of the original (plain) file
  iv           String // base64 initialisation vector
  authTag      String // base64 GCM authentication tag
  uploadedById String
  lockedAt     DateTime?
  lockedById   String?
  lockReason   String?
  deletedAt    DateTime? // tombstone: the encrypted file is removed, the row stays for the audit trail
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  case       Case  @relation(fields: [caseId], references: [id])
  uploadedBy User  @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  lockedBy   User? @relation("EvidenceLocker", fields: [lockedById], references: [id])

  @@index([caseId, deletedAt])
}

/// FR 3-3: lifecycle history shown on the case page (UC-2.3). Append-only by convention: no update or delete code paths.
model CaseEvent {
  id          String        @id @default(uuid())
  caseId      String
  type        CaseEventType
  description String
  actorId     String?
  createdAt   DateTime      @default(now())

  case  Case  @relation(fields: [caseId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([caseId, createdAt])
}

/// FR 3-3: atomic sequence per year and case-type code, used to build the UCN (DA-YYYY-CODE-000001)
model CaseCounter {
  year      Int
  typeCode  String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([year, typeCode])
}

// ---------------------------------------------------------------- hearings

/// FR: hearing scheduling with anti-clash (UC: Schedule Hearing); one hearing per judge per date per slot
model Hearing {
  id           String        @id @default(uuid())
  caseId       String
  courtroomId  String?
  judgeId      String
  date         DateTime      @db.Date
  timeSlot     Int // 1..N slot of the day
  startTime    String? // HH:mm
  type         HearingType   @default(PHYSICAL)
  isVirtual    Boolean       @default(false) // UC-4.1: held in the virtual courtroom (kept in sync with type)
  status       HearingStatus @default(SCHEDULED)
  purpose      String?
  orderSummary String?
  outcomeAt    DateTime? // when the judge recorded the hearing outcome
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  case           Case            @relation(fields: [caseId], references: [id])
  courtroom      Courtroom?      @relation(fields: [courtroomId], references: [id])
  judge          User            @relation("HearingJudge", fields: [judgeId], references: [id])
  causeListEntry CauseListEntry?
  session        CourtSession?

  // One judge / one courtroom per date and slot is enforced by PARTIAL unique indexes that ignore
  // CANCELLED hearings (hand-written SQL in migration hearing_scheduling; Prisma cannot express them).
  @@index([judgeId, date, timeSlot])
  @@index([caseId])
  @@index([date, status])
  @@index([courtroomId, date])
}

/// FR: daily cause list builder and publishing (UC: Build Cause List, View Cause List)
model CauseList {
  id          String          @id @default(uuid())
  courtId     String
  date        DateTime        @db.Date
  status      CauseListStatus @default(DRAFT)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  court     Court            @relation(fields: [courtId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  entries   CauseListEntry[]

  @@unique([courtId, date])
}

/// FR: ordered entries of a cause list (UC: Build Cause List)
model CauseListEntry {
  id          String @id @default(uuid())
  causeListId String
  hearingId   String @unique
  serialNo    Int

  causeList CauseList @relation(fields: [causeListId], references: [id])
  hearing   Hearing   @relation(fields: [hearingId], references: [id])

  @@unique([causeListId, serialNo])
}

// ---------------------------------------------------------------- fees and payments

/// FR: court fee configuration in PKR (UC: Manage System Settings)
model FeeStructure {
  id            String   @id @default(uuid())
  caseType      CaseType
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @db.Date
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([caseType, effectiveFrom])
}

/// FR: system-wide settings, e.g. geofence radius (UC: Manage System Settings)
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// FR: court fee challan generation (UC: Generate Challan)
model Challan {
  id        String        @id @default(uuid())
  challanNo String        @unique
  caseId    String
  payerId   String
  amount    Decimal       @db.Decimal(12, 2)
  status    ChallanStatus @default(UNPAID)
  dueDate   DateTime      @db.Date
  issuedAt  DateTime      @default(now())
  ledger    Json // line items of the cost ledger (base fee, claim value fee, modifier, total)
  inputHash String // hash of the amount inputs, to know when a recalculation is needed

  case     Case      @relation(fields: [caseId], references: [id])
  payer    User      @relation(fields: [payerId], references: [id])
  payments Payment[]

  @@index([caseId])
  @@index([payerId, status])
}

/// FR: mock online payment and receipt (UC: Pay Fee, View Receipt)
model Payment {
  id            String        @id @default(uuid())
  challanId     String
  payerId       String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  gatewayRef    String?       @unique
  receiptNo     String?       @unique
  cardBrand     String? // only the brand and last 4 digits are ever kept
  cardLast4     String?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  challan Challan @relation(fields: [challanId], references: [id])
  payer   User    @relation(fields: [payerId], references: [id])

  @@index([challanId])
  @@index([payerId, status])
}

// ---------------------------------------------------------------- summons

/// FR: summons delivery by process server with GPS, photo, signature (UC: Serve Summons)
model Summons {
  id               String          @id @default(uuid())
  caseId           String
  partyId          String?
  noticeType       NoticeType      @default(SUMMONS)
  recipientName    String
  recipientCnic    String?
  serviceAddress   String
  sector           String
  priority         SummonsPriority @default(NORMAL)
  status           SummonsStatus   @default(PENDING_ASSIGNMENT)
  serverId         String?
  issuedById       String?
  issuedAt         DateTime        @default(now())
  dueBy            DateTime?       @db.Date
  cancelReason     String?
  cancelledAt      DateTime?
  // proof of execution (files are AES-256-GCM encrypted at rest)
  serviceMode      ServiceMode?
  executedAt       DateTime?
  executedLat      Decimal?        @db.Decimal(9, 6)
  executedLng      Decimal?        @db.Decimal(9, 6)
  executedAccuracy Decimal?        @db.Decimal(8, 2)
  executionNotes   String?
  photoPath        String?
  photoIv          String?
  photoTag         String?
  photoSha256      String?
  signaturePath    String?
  signatureIv      String?
  signatureTag     String?
  signatureSha256  String?
  seal             String?
  sealedAt         DateTime?
  updatedAt        DateTime        @updatedAt

  case     Case             @relation(fields: [caseId], references: [id])
  party    CaseParty?       @relation(fields: [partyId], references: [id])
  server   User?            @relation("SummonsServer", fields: [serverId], references: [id])
  issuedBy User?            @relation("SummonsIssuer", fields: [issuedById], references: [id])
  attempts SummonsAttempt[]

  @@index([caseId])
  @@index([serverId, status])
  @@index([status, dueBy])
}

/// One committed field progress entry. createdAt is the authoritative server time.
model SummonsAttempt {
  id        String   @id @default(uuid())
  summonsId String
  serverId  String
  createdAt DateTime @default(now())
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  accuracyM Decimal  @db.Decimal(8, 2)
  notes     String

  summons Summons @relation(fields: [summonsId], references: [id])
  server  User    @relation("AttemptServer", fields: [serverId], references: [id])

  @@index([summonsId, createdAt])
}

/// Staff profile of a process server (Tamila officer).
model ProcessServerProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  badgeNumber String       @unique
  courtId     String
  sector      String
  phone       String?
  status      ServerStatus @default(ACTIVE)
  photoPath   String?
  photoIv     String?
  photoTag    String?
  photoSha256 String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  court           Court          @relation(fields: [courtId], references: [id])
  internProfile   InternProfile? @relation(fields: [internProfileId], references: [id])
  internProfileId String?

  @@index([courtId])
}

// ---------------------------------------------------------------- internship

/// FR: intern daily diary and supervisor review (UC: Write Diary, Review Diary)
model InternDiaryEntry {
  id            String            @id @default(uuid())
  internId      String
  caseId        String?
  entryDate     DateTime          @db.Date
  keywords      String[]
  citation      String
  /// Relevant law notes
  content       String
  reviewStatus  DiaryReviewStatus @default(SUBMITTED)
  reviewerId    String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  intern   InternProfile @relation(fields: [internId], references: [id])
  case     Case?         @relation(fields: [caseId], references: [id])
  reviewer User?         @relation("DiaryReviewer", fields: [reviewerId], references: [id])

  @@index([internId, createdAt])
  @@index([caseId])
}

/// FR: geo-fenced attendance (UC: Mark Attendance)
model Attendance {
  id             String    @id @default(uuid())
  internId       String
  date           DateTime  @db.Date
  checkInAt      DateTime
  checkOutAt     DateTime?
  lat            Decimal   @db.Decimal(9, 6)
  lng            Decimal   @db.Decimal(9, 6)
  distanceMeters Int?
  withinGeofence Boolean
  courtId        String?
  accuracyM      Int?

  intern InternProfile @relation(fields: [internId], references: [id])
  court  Court?        @relation(fields: [courtId], references: [id])

  @@unique([internId, date])
}

// ---------------------------------------------------------------- lawyer chamber

/// FR: chamber client management (UC: Manage Clients). Retainer balance is derived from RetainerTransaction rows.
model ChamberClient {
  id          String   @id @default(uuid())
  lawyerId    String
  /// CL-<6 digits>, unique inside one chamber
  clientCode  String
  caseType    String?
  onboardedOn DateTime @default(now()) @db.Date
  name        String
  cnic        String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lawyer       LawyerProfile         @relation(fields: [lawyerId], references: [id])
  billable     BillableEntry[]
  transactions RetainerTransaction[]
  expenses     ChamberExpense[]
  alertLogs    ChamberAlertLog[]

  @@unique([lawyerId, clientCode])
  @@unique([lawyerId, cnic])
  @@index([lawyerId])
}

/// One per verified lawyer, created on first access. The "silo": everything under /chamber is scoped to it.
model ChamberProfile {
  id                     String               @id @default(uuid())
  lawyerId               String               @unique
  /// CH-<6 digits>
  chamberCode            String               @unique
  name                   String
  officeAddress          String?
  partnerNames           String[]
  barMembershipIds       String[]
  practiceVerticals      String[]
  phone                  String?
  email                  String?
  licenseStatus          ChamberLicenseStatus @default(ACTIVE)
  defaultHourlyRatePkr   Decimal              @default(15000) @db.Decimal(12, 2)
  lowBalanceThresholdPkr Decimal              @default(20000) @db.Decimal(12, 2)
  lowBalanceNotifiedIds  String[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  lawyer LawyerProfile @relation(fields: [lawyerId], references: [id])
}

/// Record of "Issue Low Balance Alert Notification" (mock SMS)
model ChamberAlertLog {
  id         String   @id @default(uuid())
  lawyerId   String
  clientId   String
  balancePkr Decimal  @db.Decimal(14, 2)
  channel    String   @default("SMS")
  sentAt     DateTime @default(now())

  lawyer LawyerProfile @relation(fields: [lawyerId], references: [id])
  client ChamberClient @relation(fields: [clientId], references: [id])

  @@index([clientId, sentAt])
}

/// FR: billable hours tracking (UC: Record Billable Hours)
model BillableEntry {
  id          String   @id @default(uuid())
  lawyerId    String
  clientId    String
  caseId      String?
  workedOn    DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  hourlyRate  Decimal  @db.Decimal(12, 2)
  /// hours x hourlyRate, fixed when the entry is recorded
  amountPkr   Decimal  @db.Decimal(14, 2)
  description String?
  createdAt   DateTime @default(now())

  lawyer               LawyerProfile         @relation(fields: [lawyerId], references: [id])
  client               ChamberClient         @relation(fields: [clientId], references: [id])
  case                 Case?                 @relation(fields: [caseId], references: [id])
  retainerTransactions RetainerTransaction[]

  @@index([lawyerId, workedOn])
  @@index([clientId])
}

/// FR: retainer deposits, deductions and refunds (UC: Manage Retainer); balance = deposits - deductions - refunds
model RetainerTransaction {
  id              String         @id @default(uuid())
  clientId        String
  type            RetainerTxType
  amount          Decimal        @db.Decimal(12, 2)
  billableEntryId String?
  note            String?
  reference       String?
  createdAt       DateTime       @default(now())

  client        ChamberClient  @relation(fields: [clientId], references: [id])
  billableEntry BillableEntry? @relation(fields: [billableEntryId], references: [id])

  @@index([clientId, createdAt])
}

/// FR: chamber expense tracking (UC: Record Expense)
model ChamberExpense {
  id          String   @id @default(uuid())
  lawyerId    String
  clientId    String?
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  spentOn     DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())

  lawyer LawyerProfile  @relation(fields: [lawyerId], references: [id])
  client ChamberClient? @relation(fields: [clientId], references: [id])

  @@index([lawyerId, spentOn])
}

// ---------------------------------------------------------------- platform

/// FR: in-app / email / SMS notifications (UC: View Notifications)
model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

/// FR: notification settings (UC: Manage Notification Settings)
model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  pushEnabled  Boolean  @default(false)
  inAppEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// FR: user feedback (UC: Submit Feedback)
model Feedback {
  id                   String           @id @default(uuid())
  userId               String?
  rating               Int?
  category             FeedbackCategory @default(OTHER)
  message              String
  status               FeedbackStatus   @default(NEW)
  forwardToMaintenance Boolean          @default(false)
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime         @default(now())

  user     User? @relation(fields: [userId], references: [id])
  reviewer User? @relation("FeedbackReviewer", fields: [reviewedById], references: [id])

  @@index([createdAt])
  @@index([status, category])
}

/// FR: immutable audit logs (UC: View Audit Logs). Append-only: UPDATE/DELETE blocked by trigger.
/// actorId is intentionally not a foreign key so the log never depends on other rows.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole Role?
  action    String
  entity    String?
  entityId  String?
  success   Boolean  @default(true)
  metadata  Json?
  eventHash String? // SHA-256 of the canonical entry; null on rows written before Phase 4E ("legacy")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------- virtual hearings

/// FR: virtual courtroom control via Jitsi embed (UC: Control Virtual Courtroom)
model CourtSession {
  id              String        @id @default(uuid())
  hearingId       String        @unique // only one session per hearing
  roomName        String        @unique // random, unguessable (24 chars)
  status          SessionStatus @default(LOBBY_LOCKED)
  provider        String        @default("JITSI_PUBLIC") // JAAS or JITSI_PUBLIC at initialization
  initializedById String
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hearing       Hearing                   @relation(fields: [hearingId], references: [id])
  initializedBy User                      @relation(fields: [initializedById], references: [id])
  participants  CourtSessionParticipant[]

  @@index([status])
}

/// FR: participants of a virtual hearing (UC-3.3 Access Virtual Courtroom Link, UC-4.2 Manage Room Participants)
model CourtSessionParticipant {
  id                    String            @id @default(uuid())
  sessionId             String
  userId                String
  role                  ParticipantRole
  status                ParticipantStatus @default(JOINED)
  audioMuted            Boolean           @default(false)
  videoOff              Boolean           @default(false)
  providerParticipantId String? // the Jitsi participant id reported by the client, used for kickParticipant
  joinedAt              DateTime?
  leftAt                DateTime?
  lastSeenAt            DateTime?
  lastCommand           SessionCommand?
  lastCommandAt         DateTime?
  lastCommandById       String?

  session CourtSession @relation(fields: [sessionId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

/// Raw security exceptions (for example a non-admin account refused on an /admin route).
model SecurityEvent {
  id        String   @id @default(uuid())
  type      String // PRIVILEGE_ESCALATION
  actorId   String?
  role      Role?
  ip        String?
  method    String
  route     String
  code      String // for example ADMIN_ROUTE_FORBIDDEN or ADMIN_ROUTE_INVALID_TOKEN
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([ip, createdAt])
}

/// One open alert per offender; raised when the escalation threshold is reached.
model SecurityAlert {
  id             String              @id @default(uuid())
  actorId        String?
  actorEmail     String?
  actorRole      Role?
  ip             String?
  attemptCount   Int
  lastActionCode String
  lastRoute      String?
  status         SecurityAlertStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  blockedHosts BlockedHost[]

  @@index([status, createdAt])
}

model BlockedHost {
  id          String   @id @default(uuid())
  ip          String   @unique
  reason      String
  createdById String
  alertId     String?
  createdAt   DateTime @default(now())

  createdBy User           @relation(fields: [createdById], references: [id])
  alert     SecurityAlert? @relation(fields: [alertId], references: [id])
}

/// Every exported report, with its verification seal. The file lives under uploads/reports.
model GeneratedReport {
  id            String       @id @default(uuid())
  code          String       @unique // RPT-<YYYY>-<6 digits>
  kind          ReportKind
  format        ReportFormat
  params        Json
  filePath      String
  fileSha256    String
  dataSha256    String // SHA-256 of the data rows that went into the file
  seal          String // HMAC-SHA256 over code, kind, params, dataSha256 and time (REPORT_SEAL_SECRET)
  rowCount      Int
  generatedById String
  createdAt     DateTime     @default(now())

  generatedBy User @relation(fields: [generatedById], references: [id])

  @@index([createdAt])
}
