# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/digitaladaalat?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d
COOKIE_NAME=da_token

# Password reset
RESET_TOKEN_TTL_MINUTES=60

# Seed (development only)
SEED_ADMIN_USERNAME=admin

# Rate limits (requests per minute per IP)
AUTH_THROTTLE_LIMIT=30
FORGOT_THROTTLE_LIMIT=10
UPLOAD_THROTTLE_LIMIT=20

# File storage. UPLOAD_DIR defaults to ./uploads (git-ignored); UPLOAD_TMP_DIR defaults to the OS temp folder.
# UPLOAD_DIR=./uploads
# UPLOAD_TMP_DIR=./uploads/tmp

# Evidence vault: files are encrypted at rest with AES-256-GCM. 32 random bytes, base64. Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=CHANGE_ME

# Summons execution proof seal: HMAC-SHA256 secret. 32 random bytes, base64. Required.
# Generate with the same command as above. Never commit the real value.
SUMMONS_SEAL_SECRET=CHANGE_ME

# Report verification seal: HMAC-SHA256 secret for exported reports. 32 random bytes, base64. Required.
# Generate with the same command as above. Never commit the real value.
REPORT_SEAL_SECRET=CHANGE_ME

# Set to "1" (or a hop count / proxy list) ONLY when the API runs behind a reverse proxy, so the real
# client IP is used for the security alerts and host blocking. Leave unset for local development.
# TRUST_PROXY=1
