# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
# Pakistan time. Hearing slots are always evaluated in Pakistan time; this keeps every other local-time value too.
TZ=Asia/Karachi
PORT=4000
# The web app's URL: used for CORS and for links in e-mails. Comma-separate several origins if needed (the first
# one is used in links). Required in production. FRONTEND_ORIGIN is still accepted as the old name.
FRONTEND_URL=http://localhost:5173

# The app connects through DATABASE_URL (on Neon: the POOLED connection string, host contains "-pooler").
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/digitaladaalat?schema=public"
# Optional: the Prisma CLI (migrate deploy, seeds) uses DIRECT_URL when set (on Neon: the DIRECT connection string).
# Leave unset locally. Never point it at production from a development machine by accident.
# DIRECT_URL="postgresql://USER:CHANGE_ME@HOST/DB?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d
COOKIE_NAME=da_token

# Password reset
RESET_TOKEN_TTL_MINUTES=60

# Seed (development only)
SEED_ADMIN_USERNAME=admin
# npm run seed:demo (hosted demo only): every demo account gets this password; nothing secret is printed.
# 8 to 72 characters with upper and lower case and a digit. Demo data must never be loaded next to real data:
# seed:demo refuses a database that has other accounts unless SEED_DEMO_FORCE=true.
# DEMO_PASSWORD=CHANGE_ME
# SEED_DEMO_FORCE=false

# Rate limits (requests per minute per IP)
AUTH_THROTTLE_LIMIT=30
FORGOT_THROTTLE_LIMIT=10
UPLOAD_THROTTLE_LIMIT=20

# File storage. STORAGE_DRIVER=local (default) keeps files under UPLOAD_DIR (./uploads, git-ignored).
# STORAGE_DRIVER=s3 stores them in an S3-compatible bucket (Cloudflare R2, Supabase Storage, AWS S3); use it in
# production because the Render disk is wiped on every deploy. Evidence and summons proofs stay AES-256-GCM encrypted.
# UPLOAD_TMP_DIR (incoming uploads before validation) defaults to the OS temp folder with both drivers.
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
# UPLOAD_TMP_DIR=./uploads/tmp
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# Supabase: S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3, S3_REGION=<project region>
# S3_ENDPOINT=https://CHANGE_ME
# S3_REGION=auto
# S3_BUCKET=digitaladaalat-files
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=true

# Evidence vault: files are encrypted at rest with AES-256-GCM. 32 random bytes, base64. Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EVIDENCE_ENCRYPTION_KEY=CHANGE_ME

# Summons execution proof seal: HMAC-SHA256 secret. 32 random bytes, base64. Required.
# Generate with the same command as above. Never commit the real value.
SUMMONS_SEAL_SECRET=CHANGE_ME

# Report verification seal: HMAC-SHA256 secret for exported reports. 32 random bytes, base64. Required.
# Generate with the same command as above. Never commit the real value.
REPORT_SEAL_SECRET=CHANGE_ME

# Set to "1" (or a hop count / proxy list) ONLY when the API runs behind a reverse proxy, so the real
# client IP is used for the security alerts and host blocking. Leave unset for local development.
# Render alone is one hop (1); Vercel rewrite + Render is two hops (2), see docs/DEPLOYMENT.md.
# TRUST_PROXY=1

# Virtual courtroom (optional). With all three set, rooms run on Jitsi as a Service (8x8.vc) and the API signs a
# short-lived RS256 token per participant, so the admin's moderation commands are enforced. Without them the app
# falls back to public meet.jit.si with an unguessable room name and moderation is disabled. Never commit real values.
# JAAS_APP_ID=vpaas-magic-cookie-CHANGE_ME
# JAAS_KID=vpaas-magic-cookie-CHANGE_ME/CHANGE_ME
# JAAS_PRIVATE_KEY=CHANGE_ME_BASE64_OF_THE_PEM_PRIVATE_KEY
