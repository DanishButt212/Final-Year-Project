# Leave VITE_API_URL unset: the app calls /api on its own origin (Vite proxies it to http://localhost:4000 in
# development, and frontend/vercel.json rewrites it to the Render backend in production).
# Only set it to call an API on another origin directly (then the backend's FRONTEND_URL must allow this origin).
# VITE_API_URL=http://localhost:4000/api
