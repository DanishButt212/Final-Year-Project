.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Python caches (design skill scripts)
__pycache__/
*.pyc

# Expo / native
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local-only development credentials
docs/DEV_ACCOUNTS.md

# Generated Prisma client
backend/src/generated/

# Claude Code local/session settings; skills are installed locally per developer, not committed
.claude/skills/
.claude/settings.json
.claude/settings.local.json

# Private keys (JaaS and others)
*.pem
