dist/
build/
out/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# Environment (keep examples)
.env
.env.*
!.env.example

# Runtime data
uploads/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests
coverage/
.nyc_output/

# Editor (keep shared settings out, user settings ignored)
